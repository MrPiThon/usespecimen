---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readCapture } from '../../lib/system-files.mjs';
import { facetsFor, FACET_GROUPS } from '../../lib/facets.mjs';
import { categoryCounts } from '../../lib/categories.mjs';
import { shadeCounts } from '../../lib/colornames.mjs';
import { resolveStack } from '../../lib/webfonts.mjs';
import { readVotes, voteUrl } from '../../lib/votes.mjs';
import voteFile from '../../../content/votes.json';

const entries = await getCollection('systems');
const systems = (await Promise.all(entries.map(async (entry) => ({
  entry,
  facets: facetsFor(await readCapture(entry.id)),
})))).sort((a, b) => a.entry.data.name.localeCompare(b.entry.data.name));

// Read from the committed file, never fetched at build time — see votes.mjs.
const votes = readVotes(voteFile, systems.map(s => s.entry.id));
const votedOn = votes.fetchedAt ? votes.fetchedAt.slice(0, 10) : null;

/** The card title, set in the system's own display face at its own weight and
 *  tracking. Size stays the card's, so the grid still reads as a grid. */
const nameStyle = (d) => {
  const t = d.typography ?? {};
  const stack = resolveStack(t.headingFamily ?? t.fontFamily);
  return [
    stack ? `font-family:${stack}` : null,
    t.headingWeight ? `font-weight:${t.headingWeight}` : null,
    t.letterSpacing ? `letter-spacing:${t.letterSpacing}` : null,
  ].filter(Boolean).join(';');
};

// Only offer a filter that matches something. A facet bar advertising options
// that return nothing reads as a broken catalogue rather than a small one.
const present = new Set(systems.flatMap(s => Object.entries(s.facets ?? {})
  .map(([k, v]) => `${k}:${v}`)));
const groups = FACET_GROUPS
  .map(g => ({ ...g, options: g.options.filter(([id]) => present.has(`${g.key}:${id}`)) }))
  .filter(g => g.options.length > 0);

const categories = categoryCounts(entries);
const shades = shadeCounts(systems.map(s => s.facets));
// Broad hue names, ordered so the bar does not reshuffle as the corpus grows.
const HUE_ORDER = ['red', 'orange', 'yellow', 'green', 'teal', 'blue', 'purple', 'pink', 'neutral'];
const hues = HUE_ORDER
  .map(id => ({ id, count: systems.filter(s => s.facets?.hue === id).length }))
  .filter(h => h.count > 0);
const swatchFor = id => systems.find(s => s.facets?.hue === id)?.facets?.accent;
const shadeSwatch = id => systems.find(s => s.facets?.shade === id)?.facets?.accent;
const swatchKeys = ['background', 'card', 'primary', 'foreground'];
---

<Base
  title="Systems — Specimen"
  description="Design systems extracted from live sites, dated, spec-linted and contrast-audited. Filter by polarity, shape and contrast."
>
  <h1 style="margin-top:2rem;">Systems</h1>
  <p class="prose" style="color:var(--muted);">
    Each one extracted from the live site by a headless browser and verified
    against the DESIGN.md spec. Appearance filters are read from the measured
    tokens, so they cannot be wrong about a file. Category is the one thing a
    crawler cannot see, so it is declared rather than derived.
  </p>

  <div class="panel" style="margin-top:1.5rem;">
    <label class="visually-hidden" for="q">Search systems</label>
    <input id="q" type="search" placeholder="Search by name, brand or description…" autocomplete="off" />
    <div class="sort-row">
      <label class="facet-label" for="sort">Sort</label>
      <select id="sort">
        <option value="name">Name</option>
        <option value="votes">Most upvoted</option>
        <option value="recent">Recently verified</option>
      </select>
      {votes.total > 0 && (
        <span class="sort-note">{votes.total} upvotes, read {votedOn}</span>
      )}
    </div>
    <div id="facets" style="margin-top:0.85rem;display:grid;gap:0.6rem;">
      {categories.length > 0 && (
        <div class="facet-row">
          <span class="facet-label" title="Declared in each file, not measured">Category</span>
          {categories.map(c => (
            <button type="button" class="chip-btn" data-facet="categories" data-value={c.id}
              aria-pressed="false">{c.label} <span style="opacity:0.55">{c.count}</span></button>
          ))}
        </div>
      )}
      {hues.length > 1 && (
        <div class="facet-row">
          <span class="facet-label" title="Hue family of the measured accent">Colour</span>
          {hues.map(h => (
            <button type="button" class="chip-btn" data-facet="hue" data-value={h.id}
              aria-pressed="false">
              <span class="chip-dot" style={`background:${swatchFor(h.id)}`}></span>
              {h.id[0].toUpperCase() + h.id.slice(1)} <span style="opacity:0.55">{h.count}</span>
            </button>
          ))}
        </div>
      )}
      {shades.length > 1 && (
        <div class="facet-row">
          <span class="facet-label" title="The specific shade of the measured accent">Shade</span>
          {shades.map(sh => (
            <button type="button" class="chip-btn" data-facet="shade" data-value={sh.id}
              aria-pressed="false">
              <span class="chip-dot" style={`background:${shadeSwatch(sh.id)}`}></span>
              {sh.label} <span style="opacity:0.55">{sh.count}</span>
            </button>
          ))}
        </div>
      )}
      {groups.map(g => (
        <div class="facet-row">
          <span class="facet-label">{g.label}</span>
          {g.options.map(([id, label]) => (
            <button type="button" class="chip-btn" data-facet={g.key} data-value={id}
              aria-pressed="false">{label}</button>
          ))}
        </div>
      ))}
    </div>
    <p id="count" style="margin:var(--s6) 0 0;color:var(--muted);font-size:var(--t-body-sm-size,14px);line-height:var(--t-body-sm-leading,1.5);">
      {systems.length} systems
    </p>
  </div>

  <div class="grid" id="catalog" style="margin-top:1.5rem;">
    {systems.map(({ entry, facets }) => {
      const c = entry.data.colors ?? {};
      const captured = entry.data.provenance.capturedAt;
      return (
        <a
          class="card"
          href={`/systems/${entry.id}`}
          data-polarity={facets?.polarity}
          data-shape={facets?.shape}
          data-contrast={facets?.contrast}
          data-dark={facets?.dark}
          data-categories={(entry.data.categories ?? []).join(' ')}
          data-hue={facets?.hue}
          data-shade={facets?.shade}
          data-text={[entry.id, entry.data.name, entry.data.provenance.brand,
            entry.data.description].filter(Boolean).join(' ').toLowerCase()}
          data-votes={votes.systems[entry.id].up}
          data-captured={captured.toISOString()}
          data-name={entry.data.name.toLowerCase()}
        >
          {/* Each name set in its own system's typeface — the real one where
              the licence allows, an openly-licensed stand-in otherwise. The
              catalogue is a wall of design systems, so it should look like
              23 different design systems rather than 23 rows of Inter. */}
          <span class="card-votes" title="Upvotes, counted from thumbs-up reactions on GitHub">
            &#9650; {votes.systems[entry.id].up}
          </span>
          <h3 style={nameStyle(entry.data)}>{entry.data.name}</h3>
          <p>{entry.data.description}</p>
          <div class="swatches">
            {swatchKeys.filter(k => typeof c[k] === 'string').map(k => (
              <span class="swatch" style={`background:${c[k]}`} title={`${k} ${c[k]}`}></span>
            ))}
          </div>
          <p style="margin:var(--s5) 0 0;font-size:var(--t-caption-size,13px);line-height:var(--t-caption-leading,1.54);">
            {(entry.data.categories ?? []).map(c => <span class="tag">{c}</span>)}
            <br />
            {entry.data.provenance.brand} · {facets?.polarity}
            {facets?.dark === 'yes' && <> + dark</>} · {facets?.shape}
            {facets?.ratio && <> · {facets.ratio}:1</>}
            <br />
            verified <time datetime={captured.toISOString()}>{captured.toISOString().slice(0, 10)}</time>
          </p>
        </a>
      );
    })}
  </div>

  <p id="empty" hidden style="color:var(--muted);margin-top:1.5rem;">
    Nothing matches those filters. <button type="button" id="clear">Clear them</button>
  </p>
</Base>

<script>
  // Filtering runs over attributes already on the cards, so the full list is
  // what a reader without JavaScript sees — the filters are an enhancement, not
  // the only way in.
  const cards = [...document.querySelectorAll('#catalog .card')];
  const chips = [...document.querySelectorAll('.chip-btn')];
  const q = document.getElementById('q');
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const active = new Map();

  function apply() {
    const text = q.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const matchesFacets = [...active].every(([key, value]) => (
        // Categories are a list per system; every other facet is a single value.
        key === 'categories'
          ? (card.dataset.categories || '').split(' ').includes(value)
          : card.dataset[key] === value));
      const matchesText = !text || card.dataset.text.includes(text);
      const show = matchesFacets && matchesText;
      card.hidden = !show;
      if (show) shown += 1;
    }
    count.textContent = shown === cards.length
      ? `${cards.length} systems`
      : `${shown} of ${cards.length} systems`;
    empty.hidden = shown > 0;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const { facet, value } = chip.dataset;
      const on = active.get(facet) === value;
      // One value per group: these are alternatives, not additive tags.
      for (const other of chips) {
        if (other.dataset.facet === facet) other.setAttribute('aria-pressed', 'false');
      }
      if (on) active.delete(facet);
      else { active.set(facet, value); chip.setAttribute('aria-pressed', 'true'); }
      apply();
    });
  }

  // Sorting reorders the grid rather than rebuilding it, so every card keeps
  // its identity and the filter state above stays valid.
  const grid = document.getElementById('catalog');
  const sort = document.getElementById('sort');
  const KEYS = {
    name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
    // Descending, then name, so equal counts do not shuffle between loads.
    votes: (a, b) => Number(b.dataset.votes) - Number(a.dataset.votes)
      || a.dataset.name.localeCompare(b.dataset.name),
    recent: (a, b) => b.dataset.captured.localeCompare(a.dataset.captured)
      || a.dataset.name.localeCompare(b.dataset.name),
  };
  sort?.addEventListener('change', () => {
    const cmp = KEYS[sort.value] ?? KEYS.name;
    for (const card of [...cards].sort(cmp)) grid.appendChild(card);
  });

  q.addEventListener('input', apply);
  document.getElementById('clear')?.addEventListener('click', () => {
    active.clear();
    q.value = '';
    for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
    apply();
  });
</script>
