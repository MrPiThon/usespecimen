---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Preview from '../../components/Preview.astro';
import Specimen from '../../components/Specimen.astro';
import { hasDarkPalette, previewGaps } from '../../lib/preview.mjs';
import { fontNote } from '../../lib/webfonts.mjs';
import Base from '../../layouts/Base.astro';
import { lint } from '../../lib/design-md.mjs';
import { readCapture, readDesignFile } from '../../lib/system-files.mjs';

export async function getStaticPaths() {
  const systems = await getCollection('systems');
  return systems.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const raw = await readDesignFile(entry.id);
const capture = await readCapture(entry.id);

// Spec conformance is enforced here rather than reported. A file that fails the
// section rules is not a page with a bad badge on it — it stops the build.
const result = lint(entry);
if (result.errors.length) {
  throw new Error(
    `content/systems/${entry.id}/DESIGN.md fails the DESIGN.md spec:\n`
    + result.errors.map((e) => `  - ${e}`).join('\n'));
}

const d = entry.data;
const p = d.provenance;
const captured = p.capturedAt;
const daysAgo = Math.floor((Date.now() - captured.getTime()) / 86_400_000);
const audit = capture?.audit ?? null;
// Non-text pairs failing 3:1 is near-universal on real sites, so it is reported
// as an observation rather than treated as disqualifying. The extractor decides
// which pairs are text, because that depends on what the accent actually is.
const textFailures = audit?.textFailures ?? 0;
const showDark = hasDarkPalette(d);
const gaps = previewGaps(d);
// Per system rather than as a blanket disclaimer: "typefaces are not loaded"
// was untrue for every system using Inter, which this site already ships.
const font = fontNote(d);
---

<Base title={`${d.name} — Specimen`} description={d.description}>
  <p style="margin:2rem 0 0;color:var(--muted);font-size:0.9rem;">
    <a href="/systems">Systems</a> / {entry.id}
  </p>
  <h1 style="margin-bottom:0.25rem;">{d.name}</h1>
  <p class="prose" style="color:var(--muted);margin-bottom:1rem;">{d.description}</p>

  <p style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
    <span class="badge pass">Spec conformant</span>
    {textFailures === 0
      ? <span class="badge pass">Text contrast AA</span>
      : <span class="badge fail">{textFailures} text pair{textFailures === 1 ? '' : 's'} below AA</span>}
    {capture?.supportsDark && <span class="badge pass">Light + dark</span>}
    <span class="badge warn">Verified {daysAgo === 0 ? 'today' : `${daysAgo}d ago`}</span>
  </p>

  <div class="get">
    <pre><code>npx specimen add {entry.id}</code></pre>
    <div class="get-actions">
      <button type="button" id="copy" data-raw={raw}>Copy DESIGN.md</button>
      <a class="btn" href={`/r/${entry.id}/DESIGN.md`} download={`${entry.id}-DESIGN.md`}>Download</a>
    </div>
  </div>

  <div class="detail" style="margin-top:2rem;">
    <div>
      {/* Tabs rather than one long scroll. The specimen sheet leads because it
          is the thing you cannot get from a catalogue: measured values rendered
          as the thing they describe. */}
      <div class="tabs" role="tablist" aria-label="System views">
        <button role="tab" id="t-spec" aria-controls="p-spec" aria-selected="true">Specimen</button>
        <button role="tab" id="t-prev" aria-controls="p-prev" aria-selected="false" tabindex="-1">Preview</button>
        <button role="tab" id="t-note" aria-controls="p-note" aria-selected="false" tabindex="-1">Notes</button>
        <button role="tab" id="t-file" aria-controls="p-file" aria-selected="false" tabindex="-1">DESIGN.md</button>
      </div>

      <div class="panels">
        <section role="tabpanel" id="p-spec" aria-labelledby="t-spec">
          <Specimen data={d} />
          {showDark && (
            <>
              <h2 class="tp-h">Dark palette</h2>
              <Specimen data={d} dark />
            </>
          )}
        </section>

        <section role="tabpanel" id="p-prev" aria-labelledby="t-prev" hidden>
          <p class="tp-note">
            Real components driven only by the tokens in this file. Where it declares
            nothing, the preview falls back to a neutral default and draws its own
            hairlines dashed, so borrowed styling never reads as extracted.
            {gaps.length > 0 && <> This file supplies {gaps.join(', ')}.</>}
            {' '}{font.note}
          </p>
          <div class={`pv-grid ${showDark ? 'two' : ''}`}>
            <Preview data={d} label={showDark ? 'Light' : 'Preview'} />
            {showDark && <Preview data={d} dark label="Dark" />}
          </div>

          {p.screenshot && (
            <figure style="margin:1.5rem 0 0;">
              <Image
                src={p.screenshot}
                alt={`Screenshot of ${p.brand} captured ${captured.toISOString().slice(0, 10)}`}
                widths={[640, 960, 1440]}
                sizes="(max-width: 60rem) 100vw, 46rem"
                style="width:100%;height:auto;border:1px solid var(--border);border-radius:var(--radius);"
              />
              <figcaption class="tp-note">
                The source page as captured. Every token here was measured from this
                render, not described from it.
              </figcaption>
            </figure>
          )}
          {p.screenshotDark && (
            <figure style="margin:1.5rem 0 0;">
              <Image
                src={p.screenshotDark}
                alt={`Screenshot of ${p.brand} in dark mode, captured ${captured.toISOString().slice(0, 10)}`}
                widths={[640, 960, 1440]}
                sizes="(max-width: 60rem) 100vw, 46rem"
                style="width:100%;height:auto;border:1px solid var(--border);border-radius:var(--radius);"
              />
              <figcaption class="tp-note">
                The same page under <code>prefers-color-scheme: dark</code>.
              </figcaption>
            </figure>
          )}
        </section>

        <section role="tabpanel" id="p-note" aria-labelledby="t-note" hidden>
          <article class="prose"><Content /></article>
        </section>

        <section role="tabpanel" id="p-file" aria-labelledby="t-file" hidden>
          <p class="tp-note">
            Exactly what is in the repository, frontmatter included.
            <a href={`/r/${entry.id}/DESIGN.md`}>Raw</a>
          </p>
          <pre class="scroll"><code>{raw}</code></pre>
        </section>
      </div>
    </div>

    <aside>
      <div class="panel" style="margin-bottom:1rem;">
        <h3>Provenance</h3>
        <dl class="kv">
          <dt>Brand</dt><dd>{p.brand}</dd>
          <dt>Source</dt><dd><a href={p.source} rel="nofollow noopener">{p.source}</a></dd>
          <dt>Captured</dt><dd><time datetime={captured.toISOString()}>{captured.toISOString().slice(0, 10)}</time></dd>
          <dt>Method</dt><dd>{p.method}</dd>
          {p.derivedFrom && <><dt>Derived from</dt><dd>{p.derivedFrom}</dd></>}
          <dt>Pipeline</dt><dd>harvest v{p.harvestVersion ?? '—'} / cluster v{p.clusterVersion ?? '—'}</dd>
        </dl>
      </div>

      {audit && (
        <div class="panel">
          <h3>Contrast audit</h3>
          <table>
            <thead><tr><th>Pair</th><th>Ratio</th></tr></thead>
            <tbody>
              {audit.pairs.map((x) => (
                <tr>
                  <td>
                    {x.pair}
                    <span style="color:var(--muted)" title={x.note ?? undefined}>
                      {' '}needs {x.min}:1 · {x.criterion}
                    </span>
                  </td>
                  <td style={`color:var(--${x.aa ? 'ok' : 'bad'})`}>{x.ratio}:1</td>
                </tr>
              ))}
            </tbody>
          </table>
          {capture.warnings?.length > 0 && (
            <>
              <h3 style="margin-top:1rem;">Extraction notes</h3>
              <ul style="margin:0;padding-left:1.1rem;font-size:0.85rem;color:var(--muted);">
                {capture.warnings.map((w) => <li>{w}</li>)}
              </ul>
            </>
          )}
        </div>
      )}
    </aside>
  </div>

  <style>
    .get {
      display: flex; flex-wrap: wrap; gap: var(--s4);
      align-items: center; justify-content: space-between;
      margin-top: var(--s5);
    }
    .get pre { margin: 0; flex: 1 1 18rem; }
    .get-actions { display: flex; gap: var(--s3); }

    .tabs {
      display: flex; gap: 0.25rem; flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
      margin-bottom: var(--s5);
    }
    .tabs button {
      background: none; border: 0; cursor: pointer;
      font: inherit; font-size: 0.85rem;
      color: var(--muted);
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      /* Sits on the container's own border, so the active tab joins the panel. */
      margin-bottom: -1px;
      border-bottom: 2px solid transparent;
      transition: color var(--motion, 0s) var(--motion-ease, linear);
    }
    .tabs button:hover { color: var(--fg-strong); }
    .tabs button[aria-selected='true'] {
      color: var(--fg-strong);
      border-bottom-color: var(--accent, var(--fg-strong));
    }
    .tp-note {
      color: var(--muted); font-size: 0.9rem;
      max-width: var(--measure); margin: 0 0 var(--s4);
    }
    .tp-h { margin: var(--s6) 0 var(--s4); font-size: var(--step-3xl, 1.25rem); }
    [role='tabpanel'][hidden] { display: none; }
  </style>

  <script is:inline>
    document.getElementById('copy')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      try {
        await navigator.clipboard.writeText(btn.dataset.raw);
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = 'Copy DESIGN.md'; }, 1500);
      } catch { btn.textContent = 'Press Ctrl+C'; }
    });

    // Tabs. Progressive enhancement: without JS every panel but the first is
    // hidden, and the raw file stays reachable at /r/<slug>/DESIGN.md, which is
    // linked from the panel and from the sidebar.
    (() => {
      const list = document.querySelector('.tabs');
      if (!list) return;
      const tabs = [...list.querySelectorAll('[role=tab]')];
      const select = (tab) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        }
      };
      list.addEventListener('click', (e) => {
        const tab = e.target.closest('[role=tab]');
        if (tab) select(tab);
      });
      list.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(document.activeElement);
        if (i < 0) return;
        const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
        if (next < 0) return;
        e.preventDefault();
        const target = tabs[(next + tabs.length) % tabs.length];
        target.focus();
        select(target);
      });
    })();
  </script>
</Base>
