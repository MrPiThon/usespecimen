---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readCapture } from '../lib/system-files.mjs';
import { resolveStack } from '../lib/webfonts.mjs';
import { parseColor, toOklch, hueFamily } from '../lib/color.mjs';

const all = (await getCollection('systems'))
  .sort((a, b) => b.data.provenance.capturedAt.getTime() - a.data.provenance.capturedAt.getTime());

// Corpus figures, counted rather than claimed. Every one of these is a thing a
// competitor scraping this site would have to re-derive from the source pages.
const captures = await Promise.all(all.map(s => readCapture(s.id)));
const stats = captures.reduce((acc, cap, i) => {
  const colors = Object.values(all[i].data.colors ?? {}).filter(v => typeof v === 'string');
  acc.colors += colors.length;
  acc.pairs += (cap?.audit?.pairs ?? []).length;
  // The count worth leading with. Nobody publishes the limits of their own
  // extraction, because a directory has no extraction to be limited.
  acc.warnings += (cap?.warnings ?? []).length;
  acc.states += Object.values(cap?.states?.roles ?? {})
    .reduce((n, r) => n + Object.keys(r).length, 0);
  return acc;
}, { colors: 0, pairs: 0, warnings: 0, states: 0 });

const FIGURES = [
  { n: all.length, label: 'design systems' },
  { n: stats.colors, label: 'colour tokens, none invented' },
  { n: stats.pairs, label: 'contrast pairs audited' },
  { n: stats.states, label: 'interaction states read from CSS' },
  { n: stats.warnings, label: 'warnings published against ourselves' },
];

// The featured system leads because its file carries the widest spread of what
// the pipeline can measure — a gradient the colour tokens alone would miss, a
// full state set, and real motion.
const featured = all.find(s => s.id === 'stripe') ?? all[0];
const fc = featured.data.colors ?? {};
const fl = featured.data.layout ?? {};

const recent = all.slice(0, 6);

/**
 * Every chromatic colour the registry has measured, in hue order.
 *
 * A rainbow where each stop is a citation. Nothing here was chosen to look
 * good next to its neighbours — the order is the OKLCH hue angle and the
 * membership is "some real site paints with this", so the sequence is a fact
 * about the corpus rather than a palette.
 *
 * The chroma floor drops the greys. Below 0.06 a colour is a surface tier
 * pretending to be a hue, and a spectrum full of near-neutrals is just a
 * gradient with extra steps.
 */
const SPECTRUM_MIN_CHROMA = 0.06;
const seenHex = new Set();
const spectrum = all.flatMap((sys) => {
  const c = sys.data.colors ?? {};
  const keys = ['primary', 'sectionFill', ...Object.keys(c).filter(k => /^gradient-\d+$/.test(k))];
  return keys.map((key) => {
    const hex = c[key];
    if (typeof hex !== 'string') return null;
    const rgb = parseColor(hex);
    if (!rgb) return null;
    const lch = toOklch(rgb);
    if (lch.C < SPECTRUM_MIN_CHROMA) return null;
    return { hex, key, slug: sys.id, name: sys.data.name, brand: sys.data.provenance.brand,
             h: lch.h, family: hueFamily(lch) };
  }).filter(Boolean);
})
  .sort((a, b) => a.h - b.h)
  // Wise measures the same lime as both its accent and its ground, so it would
  // otherwise appear twice at the same angle.
  .filter(x => !seenHex.has(x.hex) && seenHex.add(x.hex));

const ramp = `linear-gradient(90deg, ${spectrum.map(x => x.hex).join(', ')})`;

// The largest step between neighbours, which is the part of the wheel nobody in
// the registry paints with. Worth naming: a spectrum that quietly interpolated
// across it would imply a coverage the corpus does not have.
const gap = spectrum.reduce((worst, x, i) => {
  if (i === 0) return worst;
  const d = x.h - spectrum[i - 1].h;
  return d > worst.d ? { d: Math.round(d), from: spectrum[i - 1], to: x } : worst;
}, { d: 0 });

const families = [...new Set(spectrum.map(x => x.family))];

/** Card titles set in the system's own display face, as on /systems. */
const nameStyle = (d) => {
  const t = d.typography ?? {};
  const stack = resolveStack(t.headingFamily ?? t.fontFamily);
  return [
    stack ? `font-family:${stack}` : null,
    t.headingWeight ? `font-weight:${t.headingWeight}` : null,
    t.letterSpacing ? `letter-spacing:${t.letterSpacing}` : null,
  ].filter(Boolean).join(';');
};
---

<Base
  title="Specimen — verified DESIGN.md files for coding agents"
  description="DESIGN.md files extracted from live sites by a real crawler: dated, spec-linted, contrast-audited and installable with one command."
>
  <section class="hero">
    <h1 class="prose" style="max-width:18ch;">DESIGN.md files your agent can trust.</h1>
    <p class="prose lede">
      Hand one to a coding agent and the UI it writes matches a chosen visual
      language. Every value was measured from the live site by a headless browser
      through <code>getComputedStyle</code> — dated, spec-linted and
      contrast-audited. <strong>No colour in this registry was written by a model.</strong>
    </p>

    <div class="panel install">
      <pre><code>npx specimen add stripe</code></pre>
      <p>
        Not on npm yet — <a href="/cli">run it from a clone</a>, give your agent{' '}
        <a href="/mcp">the MCP server</a>, or read <a href="/llms.txt">llms.txt</a>.
      </p>
    </div>
  </section>

  <section aria-label="What the registry contains">
    <dl class="figures">
      {FIGURES.map(f => (
        <div>
          <dt>{f.n}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* The whole registry as one spectrum. Every stop is an accent, a ground or a
      gradient stop some real site paints with, ordered by hue angle, and the
      whole thing is a citation list that happens to be a rainbow.

      It is also the answer to the obvious objection about the Base's "no
      indigo-to-violet-to-pink gradient" rule. That rule is about a gradient
      chosen because it looks good. This one is chosen by measurement: remove a
      system and a stop disappears. The test is whether the colours are content
      or decoration, and these are the content. */}
  <section class="spectrum">
    <h2>Every hue in the registry</h2>
    <p class="prose" style="color:var(--muted);">
      {spectrum.length} chromatic values across {all.length} systems — accents,
      section grounds and gradient stops — ordered by hue angle. Not one of them
      was chosen by a model, or by us. They are what {families.length} families of
      real websites paint with.
    </p>

    <div class="ramp" style={`background:${ramp}`} role="img"
      aria-label={`A spectrum of ${spectrum.length} measured colours from ${families.join(', ')}`}></div>

    <ol class="chips">
      {spectrum.map(x => (
        <li>
          <a href={`/systems/${x.slug}`} title={`${x.hex} — ${x.name} (${x.brand}) ${x.key}`}>
            <span class="chip-sw" style={`background:${x.hex}`}></span>
            <span class="chip-text">
              <code>{x.hex}</code>
              <span class="chip-src">{x.brand}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="fine">
      The wheel is not evenly covered, and the gaps are findings too. The widest
      is <b>{gap.d}°</b> between <code>{gap.from.hex}</code> ({gap.from.brand})
      and <code>{gap.to.hex}</code> ({gap.to.brand}) — the cyan quadrant, which
      nothing in this registry uses. A palette invented to look complete would
      have filled it.
    </p>
  </section>

  {/* Proof rather than a claim: one real file's measurements, on the page, with
      the URL and date they came from. A directory can copy the prose above; it
      cannot copy this without building a crawler. */}
  <section class="proof">
    <h2>What "measured" means</h2>
    <div class="proof-grid">
      <div>
        <h3>Colour, with the pairings checked</h3>
        <ul class="facts">
          <li><span class="dot" style={`background:${fc.background}`}></span> canvas <code>{fc.background}</code></li>
          <li><span class="dot" style={`background:${fc.foreground}`}></span> body text <code>{fc.foreground}</code></li>
          <li><span class="dot" style={`background:${fc.primary}`}></span> accent <code>{fc.primary}</code></li>
          {fc['gradient-1'] && (
            <li>
              <span class="dot" style={`background:linear-gradient(120deg, ${fc['gradient-1']}, ${fc['gradient-2'] ?? fc['gradient-1']})`}></span>
              gradient stops <code>{fc['gradient-1']}</code> → <code>{fc['gradient-2']}</code>
            </li>
          )}
        </ul>
        <p class="fine">
          Those last two exist only inside a gradient. A palette that listed the
          solid colours alone would leave out the most recognisable thing on the
          page.
        </p>
      </div>
      <div>
        <h3>And the parts a palette misses</h3>
        <ul class="facts">
          {fl.measure && <li><b>{fl.measure}</b> <span>content measure</span></li>}
          {fl.sectionSpacing && <li><b>{fl.sectionSpacing}</b> <span>between sections</span></li>}
          {fl.heroHeight && (
            <li><b>{fl.heroHeight}</b> <span>hero, {fl.heroHeadingSize} headline</span></li>
          )}
          {featured.data.motion && (
            <li>
              <b>{featured.data.motion.duration}</b> <span>{featured.data.motion.easing}</span>
            </li>
          )}
          {fl.sectionMedia && (
            <li><b>{fl.sectionWidth}</b> <span>sections, {fl.sectionMedia}</span></li>
          )}
        </ul>
        <p class="fine">
          Structure, composition and timing — the difference between a page in
          the right colours and a page that reads like the real thing.
        </p>
      </div>
    </div>
    <p class="fine">
      From <a href={featured.data.provenance.source} rel="nofollow noopener">{featured.data.provenance.source}</a>,
      captured {featured.data.provenance.capturedAt.toISOString().slice(0, 10)}.{' '}
      <a href={`/systems/${featured.id}`}>See the whole file</a>
    </p>
  </section>

  <section>
    <h2>Recently verified</h2>
    <div class="grid" style="margin-top:1rem;">
      {recent.map((s) => {
        const c = s.data.colors ?? {};
        return (
          <a class="card" href={`/systems/${s.id}`}>
            <h3 style={nameStyle(s.data)}>{s.data.name}</h3>
            <p>{s.data.description}</p>
            <div class="swatches">
              {['background', 'card', 'primary', 'foreground']
                .filter((k) => typeof c[k] === 'string')
                .map((k) => <span class="swatch" style={`background:${c[k]}`} title={`${k} ${c[k]}`}></span>)}
            </div>
          </a>
        );
      })}
    </div>
    <p style="margin-top:1.5rem;"><a href="/systems">All {all.length} systems</a></p>
  </section>

  <section class="prose">
    <h2>Why this is different</h2>
    <ul>
      <li><strong>The whole file is on the page.</strong> Rendered, copyable, and
        available raw at a permanent URL. No sign-in, no paywall.</li>
      <li><strong>Dated and reproducible.</strong> Each entry records when it was
        captured, from which URL, and by which pipeline version.</li>
      <li><strong>Validated at build time.</strong> A file that breaks the spec's
        section rules fails the build, so it cannot reach this site.</li>
      <li><strong>Honest about gaps.</strong> Where the extractor could not
        observe a token, the file omits it and says why. That is what those
        {' '}{stats.warnings} warnings are, and they ship with the files.</li>
    </ul>
  </section>

  <style>
    .lede {
      font-size: var(--t-lead-size, 20px);
      line-height: var(--t-lead-leading, 1.33);
      letter-spacing: var(--t-lead-track, -0.24px);
      color: var(--muted);
    }
    .lede strong { color: var(--fg-strong); font-weight: inherit; }

    .install { max-width: 32rem; margin-top: var(--s5); border-radius: var(--radius-2xl, 12px); }
    .install pre { margin: 0; }
    .install p {
      margin: var(--s4) 0 0; color: var(--muted);
      font-size: var(--t-caption-size, 13px);
      line-height: var(--t-caption-leading, 1.54);
    }

    .figures {
      display: grid; gap: var(--s4);
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
      margin: 0; padding: var(--s5) 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .figures dt {
      font-size: var(--step-5xl, 2rem); line-height: 1;
      color: var(--fg-strong); font-weight: var(--heading-weight, 600);
      font-variant-numeric: tabular-nums;
    }
    .figures dd {
      margin: var(--s2) 0 0; color: var(--muted); max-width: 18ch;
      font-size: var(--t-caption-size, 13px);
      line-height: var(--t-caption-leading, 1.54);
    }

    .proof-grid {
      display: grid; gap: var(--s5) var(--s6); margin-top: var(--s4);
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    }
    .proof h3 { font-size: var(--step-2xl, 1rem); margin: 0 0 var(--s3); }
    .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
    /* Each item is exactly two flex children — a marker and one span of text.
       Leaving bare text nodes between elements makes each one its own flex item
       and gives it the gap, which rendered "full-bleed , balanced". */
    .facts li {
      display: flex; align-items: baseline; gap: var(--s5);
      font-size: var(--t-body-sm-size, 14px);
      /* The row carries two code spans and neither will shrink below its own
         text, so at 320px it set the page width instead of wrapping. */
      flex-wrap: wrap; min-width: 0;
    }
    .facts .dot { align-self: center; }
    .facts b { color: var(--fg-strong); font-variant-numeric: tabular-nums; }
    .facts code { font-size: var(--t-caption-size, 13px); }
    .dot {
      width: 1.1rem; height: 1.1rem; flex: none;
      border-radius: var(--radius-sm);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 20%, transparent);
    }
    /* The spectrum. Deliberately the largest single element on the page after
       the headline: it is the best proof this registry has, and it was sitting
       unshown across 23 detail pages. */
    .ramp {
      height: 5rem; margin: var(--s6) 0 var(--s5);
      border-radius: var(--radius-lg, 8px);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 18%, transparent);
    }
    .chips {
      list-style: none; margin: 0; padding: 0;
      display: grid; gap: var(--s3);
      /* 9rem, so a phone gets two columns rather than thirty stacked rows. */
      grid-template-columns: repeat(auto-fill, minmax(min(9rem, 100%), 1fr));
    }
    .chips a {
      display: flex; align-items: center; gap: var(--s5);
      text-decoration: none; min-width: 0;
      padding: var(--s3) var(--s5);
      border: 1px solid var(--border);
      border-radius: var(--radius-md, 6px);
      background: var(--surface);
    }
    .chips a:hover { border-color: var(--faint); background: var(--surface-2); }
    .chip-sw {
      width: 1.4rem; height: 1.4rem; flex: none;
      border-radius: var(--radius-sm);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 22%, transparent);
    }
    .chips code { font-size: var(--t-caption-size, 13px); }
    /* Stacked, not side by side. On one line the brand was the flex item that
       could shrink, so at three columns it ellipsised down to a single letter
       and every chip read "S." */
    .chip-text { display: grid; min-width: 0; }
    .chip-src {
      color: var(--muted); font-size: var(--step-sm, 12px);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .spectrum .fine b { color: var(--fg-strong); }

    .fine {
      color: var(--muted); max-width: 46ch; margin: var(--s3) 0 0;
      font-size: var(--t-caption-size, 13px);
      line-height: var(--t-caption-leading, 1.54);
    }
  </style>
</Base>
