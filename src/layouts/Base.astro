---
// Self-hosted so the build has no runtime dependency on a font CDN. The theme
// file names this face; themeVars() throws if that ever stops being true.
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { THEME_SLUG, themeVars } from '../lib/theme.mjs';

// The site is styled by a file in its own registry. If that entry ever stops
// validating, the build fails here rather than silently falling back to the
// stylesheet defaults — a registry that cannot wear its own file has a problem
// worth stopping for.
const theme = await getEntry('systems', THEME_SLUG);
if (!theme) throw new Error(`Theme system "${THEME_SLUG}" is not in the collection.`);
const vars = themeVars(theme.data);

interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Every absolute URL derives from the one `site` value in astro.config.mjs, so a
// domain move stays a one-line change.
const canonical = new URL(path, Astro.site).href;
// Stamped at build. A static year goes stale the moment it turns January.
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <style set:html={`:root {
${vars}
}`}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Specimen</a>
        <nav>
          <a href="/systems" aria-current={path.startsWith('/systems') ? 'page' : undefined}>Systems</a>
          <a href="/spec" aria-current={path === '/spec' ? 'page' : undefined}>Spec</a>
          <a href="/validate" aria-current={path === '/validate' ? 'page' : undefined}>Validate</a>
          <a href="/cli" aria-current={path === '/cli' ? 'page' : undefined}>CLI</a>
          <a href="/mcp" aria-current={path === '/mcp' ? 'page' : undefined}>MCP</a>
        </nav>
      </div>
    </header>

    <main class="wrap"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cols">
          <div class="footer-about">
            <a class="brand" href="/">Specimen</a>
            <p>
              Verified DESIGN.md files for coding agents. Every token is measured
              from the live site by a headless browser — dated, spec-linted and
              contrast-audited, never described from a screenshot.
            </p>
          </div>

          <nav aria-labelledby="f-cat">
            <h2 id="f-cat">Catalogue</h2>
            <a href="/systems">Systems</a>
            <a href="/spec">The spec</a>
            <a href="/validate">Validate a file</a>
          </nav>

          <nav aria-labelledby="f-tools">
            <h2 id="f-tools">Tools</h2>
            <a href="/cli">CLI</a>
            <a href="/mcp">MCP server</a>
            <a href={`/r/${THEME_SLUG}/DESIGN.md`}>Raw endpoint</a>
          </nav>

          <nav aria-labelledby="f-project">
            <h2 id="f-project">Project</h2>
            <a href="/about">About</a>
            <a href="/submit">Submit or correct</a>
            <a href="https://github.com/MrPiThon/usespecimen" rel="noopener">GitHub</a>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>
            &copy; {year} Specimen. Brand names are used for identification only —
            see <a href="/about">provenance, trademarks and removal</a>.
          </p>
          <p>Website designed and developed by Coursey Creative.</p>
        </div>
      </div>
    </footer>

  </body>
</html>
