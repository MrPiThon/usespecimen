---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { THEME_SLUG, themeVars, themeCredit } from '../lib/theme.mjs';

// The site is styled by a file in its own registry. If that entry ever stops
// validating, the build fails here rather than silently falling back to the
// stylesheet defaults — a registry that cannot wear its own file has a problem
// worth stopping for.
const theme = await getEntry('systems', THEME_SLUG);
if (!theme) throw new Error(`Theme system "${THEME_SLUG}" is not in the collection.`);
const vars = themeVars(theme.data);
const credit = themeCredit(theme.data);

interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Every absolute URL derives from the one `site` value in astro.config.mjs, so a
// domain move stays a one-line change.
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <style set:html={`:root {
${vars}
}`}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Specimen</a>
        <nav>
          <a href="/systems" aria-current={path.startsWith('/systems') ? 'page' : undefined}>Systems</a>
          <a href="/spec" aria-current={path === '/spec' ? 'page' : undefined}>Spec</a>
          <a href="/validate" aria-current={path === '/validate' ? 'page' : undefined}>Validate</a>
          <a href="/cli" aria-current={path === '/cli' ? 'page' : undefined}>CLI</a>
          <a href="/mcp" aria-current={path === '/mcp' ? 'page' : undefined}>MCP</a>
        </nav>
      </div>
    </header>

    <main class="wrap"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Every file here was extracted from the live site by a headless browser,
          dated, spec-linted and contrast-audited. Brand names are used for
          identification only — see <a href="/about">provenance, trademarks and
          removal</a>. <a href="/submit">Corrections welcome</a>.
        </p>
        <p>
          This site is styled by <a href={`/systems/${THEME_SLUG}`}>{credit.name}</a>,
          a file in its own catalogue — the tokens above are read from its
          frontmatter at build time, not copied. It declares no foreground for its
          accent and no spacing grid, so nothing here is filled with the accent and
          the spacing is its own observed steps. It is dark-only, so this site is
          too.
        </p>
      </div>
    </footer>

  </body>
</html>
