# Static builds drop Response headers, so the raw-file contract lives here.
# Agents fetch these cross-origin, so they must stay CORS-open and plain text.
/r/*
  Access-Control-Allow-Origin: *
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

# The catalog is JSON, so it needs its own content type ahead of the rule above.
/r/index.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# The LLM-facing index. Same contract as the raw files: agents fetch it
# cross-origin, and an endpoint's own Response headers do not survive a static
# build. Change this and vercel.json together — _headers is inert on Vercel.
/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
